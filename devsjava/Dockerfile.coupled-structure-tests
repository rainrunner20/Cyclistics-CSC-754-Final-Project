# Test-only graph wiring checks. DO NOT mistake this for real DEVS-Suite integration.
FROM eclipse-temurin:17-jdk-jammy
WORKDIR /workspace
COPY src/main/java/ src/main/java/
COPY test_support/src/ test_support/src/
RUN mkdir -p /workspace/build && \
    javac --release 17 -d /workspace/build \
      test_support/src/GenCol/entity.java \
      test_support/src/model/modeling/content.java \
      test_support/src/model/modeling/message.java \
      test_support/src/view/modeling/ViewableAtomic.java \
      test_support/src/view/modeling/ViewableDigraph.java \
      src/main/java/org/cyclistics/devs/CyclistGenerator.java \
      src/main/java/org/cyclistics/devs/ObstructionController.java \
      src/main/java/org/cyclistics/devs/LaneBottleneck.java \
      src/main/java/org/cyclistics/devs/CyclisticsCoupledModel.java \
      test_support/src/org/cyclistics/devs/CoupledStructureSmokeTests.java
CMD ["java", "-cp", "/workspace/build", "org.cyclistics.devs.CoupledStructureSmokeTests"]
